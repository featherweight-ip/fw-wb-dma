// THE SCENARIO LAYER over the blocking operations. Compiled only with
// wb_dma_cfg_pkg::HAS_BLOCKING.
//
// One file for the same two reasons blocking_ops.pss is one file: these three
// actions appear and disappear together with one flag and no build wants a
// subset, and pssparser cannot see a `compile if` declaration from a later
// source file anyway (defect 4, docs/pssparser-defects-2026-08-02.md) -- these
// bodies call transfer_single() and friends, which are gated in
// blocking_ops.pss, so they must be gated where they can still see them.
//
// WHY THE NON-BLOCKING PROFILE HAS NO SCENARIO LAYER AT ALL
//
// An action's exec body runs to completion before the action retires. A
// scenario layer over the non-blocking core would therefore have to either spin
// inside a body -- which is the thing that layer exists to keep out of the
// model -- or split each operation into an arm-action and a wait-action, which
// is exactly the slicing the note below argues against. So the non-blocking
// profile has a DRIVER API, not a scenario layer, and presenting tests/pss to
// it is a hard error rather than a silent loss of actions (see the compile
// assert in tests/pss/pss_top.pss).
//
// THE OPERATION MODEL PROPER IS THE FUNCTIONS; the actions exist so a scenario
// can compose operations -- and composition is where this device's concurrency
// lives. Multi-channel activity is PARALLEL COMPOSITION of these, not one
// operation sliced into arm-and-wait halves: `arb`, `hol` and any bandwidth or
// priority scenario are N of these issued in parallel, and nothing in the
// operation model changes with channel count.
//
// Note that this is not in tension with the start/check split. That split is
// about WHAT A TARGET CAN EXECUTE; slicing an action in two would be about how
// a SCENARIO is expressed, and the answer there is still `parallel`.
import addr_reg_pkg::*;
import std_pkg::*;
import wb_dma_cfg_pkg::*;
import wb_dma_types_pkg::*;

extend component wb_dma_ch_c {

  compile if (wb_dma_cfg_pkg::HAS_BLOCKING) {

    // Scenario-layer wrapper for transfer_single().
    action transfer_single_a {
        rand wb_dma_ch_cfg_s    cfg;

        // Set when the scenario expects the transfer to be aborted or to hit a
        // bus error, so an ERROR return is the intended outcome rather than a
        // failure. Reaching an error at all requires a second model driving
        // err_i, or a concurrent stop_channel_a (§5.1).
        rand bool               expect_error;

        constraint default expect_error == false;

        // The channel must be one this instance actually has.
        constraint cfg.prio < 8;

        exec body {
            wb_dma_status_e status;

            status = comp.transfer_single(cfg);

            if (status == WB_DMA_ERROR && expect_error == false) {
                message(LOW, "wb_dma: transfer_single completed with ERROR");
            }
        }
    }

    // Scenario-layer wrapper for transfer_list().
    //
    // Depends on a prior configure_channel (for CHK_SZ, mode, priority and the
    // address masks, none of which a descriptor carries) and on a descriptor
    // list already in memory. Neither dependency is expressed as a flow object
    // in this pass -- the operation model stops at operations, and the
    // precondition layer is future work (§6).
    action transfer_list_a {
        // Head of the descriptor chain, as returned when the list was built.
        // Must be reachable from interface 0.
        addr_handle_t   head;

        rand bool       expect_error;

        constraint default expect_error == false;

        exec body {
            wb_dma_status_e status;

            status = comp.transfer_list(head);

            if (status == WB_DMA_ERROR && expect_error == false) {
                message(LOW, "wb_dma: transfer_list completed with ERROR");
            }
        }
    }

    // Scenario-layer wrapper for stop_channel().
    //
    // By definition this runs CONCURRENTLY with the transfer_single_a it aborts
    // -- it is not a sequential step after one. Traversing it on its own,
    // against an idle channel, is legal but meaningless.
    //
    // Both blocking operations complete off the one event: this returns, and so
    // does the aborted transfer, with status ERROR.
    action stop_channel_a {
        exec body {
            wb_dma_status_e status;
            status = comp.stop_channel();
        }
    }

  }
}
