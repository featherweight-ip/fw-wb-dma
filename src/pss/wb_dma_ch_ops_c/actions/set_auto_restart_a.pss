// Scenario-layer wrapper for the set_auto_restart() operation.
//
// The reason this is an action rather than a helper: clearing ARS is the
// TERMINATING EVENT for an auto-restarting transfer_single_a. That transfer is
// deliberately non-terminating on its own, so a scenario containing one must
// contain a concurrent branch that traverses this (or stop_channel_a).
extend component wb_dma_ch_ops_c {

    action set_auto_restart_a {
        rand bit enable;

        exec body {
            comp.set_auto_restart(enable);
        }
    }
}
