// Scenario-layer wrapper for the transfer_list() operation.
//
// Depends on a prior configure_channel (for CHK_SZ, mode, priority and the
// address masks, none of which a descriptor carries) and on a descriptor list
// already in memory. Neither dependency is expressed as a flow object in this
// pass -- the operation model stops at operations, and the precondition layer
// is future work (§6).
import addr_reg_pkg::*;
import std_pkg::*;
import wb_dma_types_pkg::*;

extend component wb_dma_ch_ops_c {

    action transfer_list_a {
        // Head of the descriptor chain, as returned when the list was built.
        // Must be reachable from interface 0.
        addr_handle_t   head;

        rand bool       expect_error;

        constraint default expect_error == false;

        exec body {
            wb_dma_status_e status;

            status = comp.transfer_list(head);

            if (status == WB_DMA_ERROR && expect_error == false) {
                message(LOW, "wb_dma: transfer_list completed with ERROR");
            }
        }
    }
}
