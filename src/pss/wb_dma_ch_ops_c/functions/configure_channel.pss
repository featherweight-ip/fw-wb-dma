// configure_channel -- operation model §3.2, group 1, level: configuration.
//
// completes_when: CHn_SZ / A0 / AM0 / A1 / AM1 and the RW bits of CHn_CSR
//                 reflect cfg. The channel is NOT enabled.
// waits for:      nothing. Straight-line stores, no driver state, callable
//                 from any context including with a lock held.
//
// Kept alongside transfer_single(), which takes the same cfg and subsumes it
// for the common case, for exactly one reason: transfer_list() needs CHK_SZ
// programmed BEFORE the chain is armed (§3.3) and a descriptor carries no
// chunk size. That is a real caller with a real argument.
//
// The CSR is written whole rather than read-modify-written, because at this
// point nothing is running on the channel and a read would consume the ROC
// status bits for no reason.
import wb_dma_regs_pkg::*;
import wb_dma_types_pkg::*;

extend component wb_dma_ch_ops_c {

    target function void configure_channel(wb_dma_ch_cfg_s cfg) {
        wb_dma_ch_sz_s   sz;
        wb_dma_ch_csr_s  csr;

        regs.adr0.write_val(cfg.src);
        regs.am0.write_val(cfg.src_mask);
        regs.adr1.write_val(cfg.dst);
        regs.am1.write_val(cfg.dst_mask);

        sz.tot_sz = cfg.tot_sz;
        sz.chk_sz = cfg.chk_sz;
        regs.sz.write(sz);

        // Enable last and separately: writing CH_EN is what arms the channel,
        // so it must not ride along with the configuration write.
        csr.ch_en        = 0;

        csr.src_sel      = (bit)cfg.src_if;
        csr.dst_sel      = (bit)cfg.dst_if;
        csr.inc_src      = cfg.inc_src;
        csr.inc_dst      = cfg.inc_dst;
        csr.mode         = (bit)cfg.mode;
        csr.prio         = cfg.prio;
        csr.sz_wb        = cfg.sz_wb;

        // Capability-gated bits. Programming one of these on a channel built
        // without the capability is not an error -- hardware ignores it -- so
        // the model declines to set it rather than pretending it took effect.
        if (caps.ars) {
            csr.ars     = cfg.auto_restart;
            csr.rest_en = cfg.hw_restart_en;
        }

        csr.ine_done     = cfg.int_on_done;
        csr.ine_err      = cfg.int_on_err;
        csr.ine_chk_done = cfg.int_on_chunk;

        regs.csr.write(csr);
    }
}
