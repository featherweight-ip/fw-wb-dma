// set_auto_restart -- operation model §3.2, group 1, level: configuration.
//
// completes_when: ARS updated.
// waits for:      nothing.
//
// Distinct from configure_channel() because clearing ARS mid-flight is the
// documented way to terminate an auto-restarting channel (§3.2.1) -- invoked on
// its own, against a live channel, from a parallel scenario branch. Rewriting
// the whole register bank to do that would be wrong.
//
// This is therefore the terminating event for an ARS transfer_single(): once
// ARS is clear, the in-flight iteration retires and DONE asserts.
//
// Read-modify-write against a live channel, so it shares the hazard described
// in stop_channel.pss: the read consumes any pending ROC status. Enabling ARS
// before arming is unaffected; disabling it mid-flight is the exposed case.
import wb_dma_regs_pkg::*;

extend component wb_dma_ch_ops_c {

    target function void set_auto_restart(bit enable) {
        wb_dma_ch_csr_s csr;

        // Silently ignored by hardware on a channel built without ARS, so
        // decline rather than pretend.
        if (!caps.ars) {
            return;
        }

        csr = regs.csr.read();
        csr.ars = enable;
        regs.csr.write(csr);
    }
}
