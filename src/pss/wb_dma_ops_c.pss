// The MMIO operation model for the WISHBONE DMA/Bridge core
// (docs/wb_dma_operation_model.md §3, `dma_mmio_c` in that document).
//
// Scope, from §1: an operation model exists for each logical interface the
// system INITIATES on. That is MMIO -- everything the processor reaches by
// load/store -- and the per-channel hardware handshake (wb_dma_hs_c). The
// WISHBONE masters are device-driven and out of scope; so is descriptor
// FETCHING, though descriptor AUTHORING is here, because it is the processor
// that initiates it.
//
// Deliberately absent:
//
//   * bulk buffer access. The test writer already has a path to memory
//     (read32/write32); filling a source region and checking a destination
//     region are not operations of this model.
//   * bus-error injection. It belongs to whichever component can drive err_i.
//     A DMA-error-reaction test is a composition of two operation models, not
//     a wider version of this one (§5.1).
//   * bridge_access. The pass-through path is reachable only with a target on
//     the far interface; omitted by review decision.
//
// This component holds the engine-GLOBAL operations. Everything per-channel is
// on wb_dma_ch_ops_c.

import addr_reg_pkg::*;
import wb_dma_regs_pkg::*;
import wb_dma_types_pkg::*;

component wb_dma_ops_c {

    // The engine-global register bank: PAUSE, the two routing masks, the two
    // pending snapshots.
    wb_dma_regs_c       regs;

    // Per-channel operations. Sized at the BUILD-TIME channel count, because
    // the register structure is static; num_ch is how many an instance
    // actually uses, and operations should be issued only to ch[0..num_ch-1].
    wb_dma_ch_ops_c     ch[wb_dma_regs_pkg::WB_DMA_MAX_CH];

    int                 num_ch   = wb_dma_regs_pkg::WB_DMA_MAX_CH;

    // Build-time pri_sel: caps the usable range of wb_dma_ch_cfg_s.prio.
    // Legal values are 1, 4 and 8; a priority above this is not an error, it
    // just does not discriminate.
    int                 pri_levels = 4;

    // Bind the whole register file. Called from pss_top's exec init_down,
    // which is where the address space that owns `base` is built.
    //
    // Each channel gets its own handle rather than being nested in one device
    // group: that is what lets the per-channel operations access registers
    // without indexing. The offsets come from the map constants, so the stride
    // stays device knowledge held in one place.
    solve function void \init (addr_handle_t base) {
        regs.set_handle(base);

        foreach (ch[i]) {
            ch[i].\init (i,
                make_handle_from_handle(base,
                    wb_dma_regs_pkg::WB_DMA_CH_BASE +
                    i * wb_dma_regs_pkg::WB_DMA_CH_STRIDE));
        }
    }
}
