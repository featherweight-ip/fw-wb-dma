// configure_interrupt_routing -- operation model §3.2, group 2,
// level: configuration.
//
// completes_when: INT_MSK_A/B updated.
// waits for:      nothing.
//
// Two banks, two independent aggregate outputs; a channel may be routed to
// both. Because every end-to-end operation completes on an interrupt, this is
// a HARD PREREQUISITE for all of them -- the one configuration operation with
// no optional reading.
//
// The mask stays a bit vector rather than becoming a channel list because it
// genuinely is one: bit N routes channel N.
import wb_dma_regs_pkg::*;
import wb_dma_types_pkg::*;

extend component wb_dma_ops_c {

    target function void configure_interrupt_routing(
            wb_dma_int_bank_e bank,
            bit[31]           channel_mask) {
        wb_dma_intvec_s vec;

        vec.ch = channel_mask;

        match (bank) {
            [WB_DMA_INT_A]: regs.int_msk_a.write(vec);
            [WB_DMA_INT_B]: regs.int_msk_b.write(vec);
        }
    }
}
