// pause_engine -- operation model §3.2, group 2, level: configuration.
//
// completes_when: a readback of CSR.PAUSE matches the requested value. The
//                 engine only pauses after the CURRENT transfer completes, so
//                 the write and the state change are NOT simultaneous.
// waits for:      the readback. The only wait in the model with no interrupt
//                 behind it -- in a real driver, a retry/timer loop rather
//                 than an ISR wake.
//
// Global, not per-channel. The readback-defined completion is the entire reason
// this is an operation rather than a register write, and it is the clearest
// small illustration of the blocking rule: the operation is not done when the
// store retires.
//
// The global CSR is not read-to-clear, so unlike the channel CSR this poll is
// genuinely side-effect-free and may run any number of times.
import wb_dma_regs_pkg::*;

extend component wb_dma_ops_c {

    target function void pause_engine(bit pause) {
        wb_dma_gcsr_s gcsr;

        gcsr.pause = pause;
        regs.csr.write(gcsr);

        while (true) {
            gcsr = regs.csr.read();
            if (gcsr.pause == pause) {
                break;
            }
            yield;
        }
    }
}
