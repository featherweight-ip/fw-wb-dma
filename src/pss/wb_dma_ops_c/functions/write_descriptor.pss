// write_descriptor -- operation model §3.2, group 3, level: configuration.
// (`write_descriptor_list` in the first pass, reshaped per review: this takes
// `at` and `prev` and returns the next slot, so a caller can build a list
// in-place one link at a time instead of handing over a whole array.)
//
// completes_when: the descriptor is in memory at `at`, terminated (DESC_NEXT
//                 zero), and `prev` -- if there is one -- points at it.
// waits for:      nothing.
// returns:        a handle to the slot immediately after `at`, i.e. the
//                 natural place for the next descriptor.
//
// This survives practice 2 -- "the test writer already has a path to memory" --
// where a generic write_buffer() would not, and the distinction is worth being
// explicit about: this operation is not a path to memory, it is DEVICE
// KNOWLEDGE that happens to be written through one. The next-pointer linkage
// and the EOL rule are the operation; the layout is declared by wb_dma_desc_s;
// write32 is merely how it lands.
//
// `at` must be reachable from interface 0: descriptors are fetched from IF0
// regardless of which interface the DATA moves on (§3.3).
//
// Passing a null/zero `prev` means "this is the head of the list". The check is
// on the resolved address rather than a handle comparison, because an address
// handle is opaque and not usefully comparable.
import addr_reg_pkg::*;
import wb_dma_regs_pkg::*;
import wb_dma_types_pkg::*;

extend component wb_dma_ops_c {

    target function addr_handle_t write_descriptor(
            addr_handle_t   at,
            addr_handle_t   prev,
            wb_dma_desc_s   desc) {
        wb_dma_desc_s d;
        bit[32]       csr_word;

        // Deep copy. `desc` is the caller's struct -- aggregates are passed by
        // handle -- and we terminate this link ourselves.
        d      = desc;
        d.next = 0;

        // -- serialization -------------------------------------------------
        // This whole block is one call:
        //
        //     write_struct(at, d);
        //
        // wb_dma_desc_s already declares the packed layout, so nothing here
        // adds information. It is spelled out only because read_struct and
        // write_struct are commented out of the front end's addr_reg_pkg
        // ("TODO: generic type") and do not resolve. Replace the block with
        // the call above when they land -- no other change is needed.
        csr_word  = (bit[32])d.csr.tot_sz;
        csr_word |= ((bit[32])d.csr.dst_sel) << 16;
        csr_word |= ((bit[32])d.csr.src_sel) << 17;
        csr_word |= ((bit[32])d.csr.inc_dst) << 18;
        csr_word |= ((bit[32])d.csr.inc_src) << 19;
        csr_word |= ((bit[32])d.csr.eol)     << 20;

        write32(at,                                                csr_word);
        write32(make_handle_from_handle(at, 4),                    d.adr0);
        write32(make_handle_from_handle(at, 8),                    d.adr1);
        write32(make_handle_from_handle(at, WB_DMA_DESC_NEXT_OFF), d.next);
        // -------------------------------------------------------------------

        // Extend the list: point the previous descriptor at this one.
        if (addr_value(prev) != 0) {
            write32(make_handle_from_handle(prev, WB_DMA_DESC_NEXT_OFF),
                    (bit[32])addr_value(at));
        }

        return make_handle_from_handle(at, WB_DMA_DESC_BYTES);
    }
}
