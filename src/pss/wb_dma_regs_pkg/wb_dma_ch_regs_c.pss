// One channel's MMIO register bank: the eight registers at stride 4 spanning
// 0x20 bytes, and the group that places them (docs/dma_doc.md §4.4).
//
// A register bank is one artifact with one address decode, so it is one file:
// the registers are never referenced apart from the group that maps them.
//
// This is a TOP-LEVEL register group: each wb_dma_ch_ops_c instance owns one
// and binds it with set_handle() to its own non-allocatable region at
// WB_DMA_CH_BASE + chan*WB_DMA_CH_STRIDE. Making the bank per-channel rather
// than an array inside one device-wide group is what keeps every register
// access in the operation code index-free -- see wb_dma_ch_ops_c.pss.
//
// All value structs are packed LITTLE_ENDIAN, so the first-declared field
// occupies bit 0 and each subsequent field stacks toward the MSB --
// declaration order IS the bit numbering. Positions match the OpenCores RTL
// and src/spl/wb_dma_spl_pkg.sv.
package wb_dma_regs_pkg {
    import std_pkg::*;
    import addr_reg_pkg::*;

    // ---------------------------------------------------------------------
    // A plain 32-bit register with no field structure
    // ---------------------------------------------------------------------
    //
    // The address and address-mask registers (CHn_A0 / CHn_AM0 / CHn_A1 /
    // CHn_AM1) and the linked list descriptor pointer (CHn_DESC). The
    // register-value type is a bit-vector rather than a packed struct, so
    // read()/read_val() and write()/write_val() are equivalent for this type.
    pure component wb_dma_word_r : reg_c<bit[32], READWRITE, 32> {}

    // ---------------------------------------------------------------------
    // CHn_CSR -- control / status (bank offset 0x00, §4.4.1 Table 6)
    // ---------------------------------------------------------------------
    //
    // Access classes worth remembering when writing operations:
    //
    //   int_err / int_done / int_chk_done   ROC -- cleared as a side effect of
    //                                       ANY host read of this register
    //   err                                 ROC as well (Table 6 "12 ROC"), so
    //                                       a read that observes an error also
    //                                       consumes it. This is why completion
    //                                       is read exactly ONCE per operation
    //                                       -- see wait_completion.pss
    //   done / busy                         RO status
    //   stop                                WO pulse
    //   ch_en                               RW, but hardware clears it on
    //                                       done/err
    //
    // Note that busy means "this channel is the one the arbiter is currently
    // servicing", NOT "this channel is armed" -- it is not a completion
    // indicator.
    struct wb_dma_ch_csr_s : packed_s<> {
        rand bit      ch_en;         //  0     RW  channel enable / start
        rand bit      dst_sel;       //  1     RW  0 = IF0, 1 = IF1
        rand bit      src_sel;       //  2     RW  0 = IF0, 1 = IF1
        rand bit      inc_dst;       //  3     RW
        rand bit      inc_src;       //  4     RW
        rand bit      mode;          //  5     RW  1 = hardware handshake
        rand bit      ars;           //  6     RW  auto restart
        rand bit      use_ed;        //  7     RW  use external descriptors
        rand bit      sz_wb;         //  8     RW  size writeback into descriptor
        rand bit      stop;          //  9     WO  abort pulse
        rand bit      busy;          // 10     RO  currently being serviced
        rand bit      done;          // 11     RO  transfer complete
        rand bit      err;           // 12     ROC error status
        rand bit[3]   prio;          // 15:13  RW  priority, 0 = lowest
        rand bit      rest_en;       // 16     RW  hardware restart enable
        rand bit      ine_err;       // 17     RW  interrupt enable: error
        rand bit      ine_done;      // 18     RW  interrupt enable: done
        rand bit      ine_chk_done;  // 19     RW  interrupt enable: chunk done
        rand bit      int_err;       // 20     ROC interrupt source: error
        rand bit      int_done;      // 21     ROC interrupt source: done
        rand bit      int_chk_done;  // 22     ROC interrupt source: chunk done
        rand bit[9]   reserved;      // 31:23  RO
    }

    pure component wb_dma_ch_csr_r : reg_c<wb_dma_ch_csr_s, READWRITE, 32> {}

    // ---------------------------------------------------------------------
    // CHn_SZ -- transfer sizes (bank offset 0x04, §4.4.2)
    // ---------------------------------------------------------------------
    //
    // Both counts are in WORDS. chk_sz == 0 means "move the whole tot_sz in one
    // chunk". chk_sz > tot_sz yields one truncated chunk, not a hang
    // (src/spl/wb_dma_de.svh: the chunk count is min(chk_sz, remaining)).
    struct wb_dma_ch_sz_s : packed_s<> {
        rand bit[12]  tot_sz;       // 11:0   RW  total transfer size, words
        rand bit[4]   reserved0;    // 15:12  RO
        rand bit[9]   chk_sz;       // 24:16  RW  chunk size, words (0 = all)
        rand bit[7]   reserved1;    // 31:25  RO
    }

    pure component wb_dma_ch_sz_r : reg_c<wb_dma_ch_sz_s, READWRITE, 32> {}

    // ---------------------------------------------------------------------
    // CHn_SWPTR -- software pointer (bank offset 0x1c, §4.4.6 Table 11)
    // ---------------------------------------------------------------------
    //
    // The consumer side of a circular buffer (§3.4, §3.5): the DMA stalls when
    // the address it is about to write would pass this pointer. Publishing how
    // far the software reader has advanced is what un-stalls the channel -- the
    // buffer's DATA is read on the test writer's own memory path, not through
    // this model.
    struct wb_dma_swptr_s : packed_s<> {
        rand bit[31]  ptr;          // 30:0  RW  software pointer
        rand bit      en;           // 31    RW  SWPTR_EN
    }

    pure component wb_dma_swptr_r : reg_c<wb_dma_swptr_s, READWRITE, 32> {}

    // ---------------------------------------------------------------------
    // The bank
    // ---------------------------------------------------------------------

    pure component wb_dma_ch_regs_c : reg_group_c {
        wb_dma_ch_csr_r   csr;      // 0x00  control / status
        wb_dma_ch_sz_r    sz;       // 0x04  total + chunk size
        wb_dma_word_r     adr0;     // 0x08  source address
        wb_dma_word_r     am0;      // 0x0c  source address mask
        wb_dma_word_r     adr1;     // 0x10  destination address
        wb_dma_word_r     am1;      // 0x14  destination address mask
        wb_dma_word_r     desc;     // 0x18  linked-list descriptor pointer
        wb_dma_swptr_r    swptr;    // 0x1c  software pointer

        function bit[64] get_offset_of_instance(string name) {
            match (name) {
                ["csr"]:   return 0x00;
                ["sz"]:    return 0x04;
                ["adr0"]:  return 0x08;
                ["am0"]:   return 0x0c;
                ["adr1"]:  return 0x10;
                ["am1"]:   return 0x14;
                ["desc"]:  return 0x18;
                ["swptr"]: return 0x1c;
                default:   return -1;
            }
        }

        // No register arrays in this group, but the scheme is "instance +
        // instance_array" (not get_offset_of_path), so both are supplied.
        function bit[64] get_offset_of_instance_array(string name, int index) {
            return -1;
        }
    }
}
