extend component pss_top {

    // A transfer aborted mid-flight by a concurrent STOP.
    //
    // The two operations complete off ONE event: ``stop_channel`` returns, and
    // so does the transfer it aborted -- with status ``WB_DMA_ERROR``, because
    // the device reports an abort as an error rather than as a clean stop.
    //
    // This is also the model's one deliberate violation of the
    // one-operation-per-channel rule that makes the completion poll safe. See
    // ``stop_channel()`` in ``wb_dma_ch_c/functions/blocking_ops.pss``, and
    // ``stop_channel_start()``, for what that costs.
    action abort_a {
        wb_dma_c::configure_interrupt_routing_a  route;
        wb_dma_ch_c::transfer_single_a           xfer;
        wb_dma_ch_c::stop_channel_a              abort;

        // The abort is the expected outcome, not a failure.
        constraint xfer.expect_error == true;

        activity {
            route;
            parallel {
                xfer;
                abort;
            }
        }
    }
}
