// wb_dma_hw_hs_seq, rewritten as operation calls (operation model §5.2).
//
//     mmio.configure_interrupt_routing(A, ALL)
//     parallel {
//         mmio.transfer_single(0, cfg{mode: HW_HANDSHAKE, ...})   # blocks to DONE
//         repeat (ceil(tot/chunk)) hs[0].request_chunk()          # feeds it
//     }
//
// This is the shape the blocking rule forces and the whole reason it is worth
// having: a HW_HANDSHAKE transfer cannot complete on its own, so the scenario
// is inherently a PARALLEL COMPOSITION of one MMIO operation and N handshake
// operations. The concurrency was never a property of the operation -- round 1
// split transfer_single into arm-and-wait halves to express exactly this, and
// that was pushing a scheduling concern into an interface contract.
import wb_dma_types_pkg::*;

extend component pss_top {

    action hw_handshake_a {
        wb_dma_c::configure_interrupt_routing_a  route;
        wb_dma_ch_c::transfer_single_a           xfer;
        wb_dma_hs_c::request_chunk_a                 feed;

        rand int  n_chunks;

        constraint xfer.cfg.mode == WB_DMA_HW_HANDSHAKE;

        // One request per chunk. chk_sz == 0 means the whole transfer moves as
        // a single chunk, so one request suffices.
        constraint n_chunks in [1..64];

        activity {
            route;
            parallel {
                xfer;
                repeat (n_chunks) {
                    feed;
                }
            }
        }
    }
}
