extend component wb_dma_hs_c {

    // Restart a channel's transfer from the beginning.
    //
    // .. warning::
    //    The spec requires no transfer in progress when ``dma_rest_i`` asserts,
    //    and this model does not enforce that -- it is the strongest candidate
    //    for the first precondition work, because it is the one case where
    //    violating it looks destructive. Until then, a scenario must not
    //    traverse this in parallel with a live transfer on the same channel.
    //
    // :realizes:  restart_transfer()
    // :exec body: pulses dma_rest_i
    action restart_transfer_a {
        exec body {
            comp.restart_transfer();
        }
    }
}
