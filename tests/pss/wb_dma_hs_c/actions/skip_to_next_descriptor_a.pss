extend component wb_dma_hs_c {

    // Advance the channel to the next descriptor on the following chunk request.
    //
    // Must be traversed immediately before a ``request_chunk_a`` on the same
    // channel: this delivers the qualifier and leaves nd asserted, and the
    // following request carries it in and clears it after the ack. Anything
    // traversed between the two breaks the pairing.
    //
    // :realizes:  skip_to_next_descriptor()
    // :exec body: asserts nd and holds it for the required lead
    action skip_to_next_descriptor_a {
        exec body {
            comp.skip_to_next_descriptor();
        }
    }
}
