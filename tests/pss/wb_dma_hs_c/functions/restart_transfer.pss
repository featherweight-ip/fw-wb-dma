import wb_dma_hs_pkg::*;

extend component wb_dma_hs_c {

    // Reload the channel's working registers from their programmed values.
    //
    // *§4, configuration.* Completes when the channel's working registers have
    // been reloaded with their originally programmed -- or last-fetched-descriptor
    // -- values. Waits for nothing observable: pin-only, asserted by
    // construction.
    //
    // Configuration rather than end-to-end because nothing leaves the device;
    // only internal state is restored. The canonical consumer is the Ethernet
    // MAC collision case in §3.10, where a partially transmitted frame has to be
    // resent from the beginning.
    //
    // Needs ``caps.ars`` on the channel and REST_EN set through the MMIO model,
    // so this is one of the few places the two operation models have an ordering
    // dependency on each other rather than merely running concurrently.
    //
    // .. warning::
    //    Open question (§6): the spec requires "no transfer in progress" when
    //    ``dma_rest_i`` asserts. That precondition is deliberately not
    //    formalized in this pass, but it is the one case where violating it
    //    looks destructive, which makes it the strongest candidate for the first
    //    precondition work. Note the tension with blocking semantics: the caller
    //    must know a concurrent ``transfer_single()`` is quiescent, and no
    //    operation reports that.
    target function void restart_transfer() {
        wb_dma_hs_pulse_rest(chan);
    }
}
